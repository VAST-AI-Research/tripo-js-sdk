{
  "name": "@vastai/tripo-sdk",
  "version": "0.2.0",
  "description": "Official JavaScript / TypeScript SDK for the Tripo3D v3 AI 3D generation API.",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    },
    "./errors": {
      "import": "./src/errors.js"
    },
    "./constants": {
      "import": "./src/constants.js"
    }
  },
  "files": [
    "src",
    "types",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "prepublishOnly": "npm test",
    "example:text": "node examples/text-to-model.js",
    "example:image": "node examples/image-to-model.js",
    "example:rig": "node examples/rig-and-animate.js"
  },
  "keywords": [
    "tripo3d",
    "tripo",
    "3d",
    "ai",
    "sdk",
    "text-to-3d",
    "image-to-3d",
    "rigging",
    "animation",
    "glb",
    "fbx"
  ],
  "author": "VAST AI <xuanwang868@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VAST-AI-Research/tripo-js-sdk.git"
  },
  "homepage": "https://github.com/VAST-AI-Research/tripo-js-sdk#readme",
  "bugs": {
    "url": "https://github.com/VAST-AI-Research/tripo-js-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
